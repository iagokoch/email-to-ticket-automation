# Copie para .env e preencha com valores reais. Nunca commitar o .env.

# --- Microsoft Graph (app-only / client credentials) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Caixa de entrada monitorada (ex.: rh@suaempresa.com.br)
MAILBOX_USER=

# --- Tiflux (API v1) ---
# Senha do "Usuário API" (Tiflux > Configurações > Integrações > Dados)
TIFLUX_TOKEN=
# E-mail desse mesmo "Usuário API"
TIFLUX_API_EMAIL=
TIFLUX_BASE_URL=https://api.tiflux.com/api/v1
TIFLUX_CLIENT_ID=
TIFLUX_DESK_ID=
TIFLUX_PRIORITY_ID=

# Solicitante fixo usado em todo ticket criado por esta automação
TIFLUX_REQUESTOR_NAME=
TIFLUX_REQUESTOR_EMAIL=
TIFLUX_REQUESTOR_PHONE_RAW=

# --- Automação ---
# Janela de busca de e-mails (horas). Ver state_store.py.
LOOKBACK_HOURS=48
# Opcional: por padrão já fica dentro da pasta do projeto.
LOG_FILE_PATH=
STATE_FILE_PATH=
